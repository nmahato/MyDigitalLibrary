{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8077"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": {
        "DEV": "",
        "PYTHONUNBUFFERED": "1",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "jinja": false,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: FastAPI (auto-reload, no breakpoints in workers)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": { "DEV": "1", "PYTHONUNBUFFERED": "1" },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": { "PYTHONPATH": "${workspaceFolder}/backend", "PYTHONUNBUFFERED": "1" },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: attach to running process",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "justMyCode": false,
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/backend", "remoteRoot": "." }
      ]
    },
    {
      "name": "Frontend: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*",
        "/src/*": "${webRoot}/*"
      },
      "preLaunchTask": "frontend: dev server"
    },
    {
      "name": "Frontend: Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "frontend: dev server"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (backend + Chrome)",
      "configurations": ["Backend: FastAPI (debug)", "Frontend: Chrome"],
      "stopAll": true,
      "presentation": { "order": 1 }
    }
  ]
}
